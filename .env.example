# Backend Server
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000
DATABASE_PATH=./data/exam_grader.db
STORAGE_DIR=./data/uploads

# Preprocessing & PII Anonymization
PDF_RENDER_DPI=300
SKIP_COVER_PAGE=true
AUTO_SPLIT_SPREADS=true
HEADER_MASK_PCT=0.0

# Modal.com Serverless GPU OCR Service
MODAL_OCR_VLM_URL=https://<your-workspace>--exam-grader-ocr-ocrservice-transcribe-vlm.modal.run
MODAL_OCR_BASELINE_URL=https://<your-workspace>--exam-grader-ocr-baseline-transcribe-paddle-trocr.modal.run
MODAL_API_KEY=replace-with-strong-shared-secret
MOCK_MODAL=true

# Variable AI Grader Provider (Phase 4)
GRADER_PROVIDER=gemini
GRADER_MODEL=gemini-3-flash-preview
GRADER_BASE_URL=
GEMINI_API_KEY=replace-with-google-ai-studio-key
GEMINI_MIN_DELAY_SEC=1.5
MOCK_GEMINI=true
